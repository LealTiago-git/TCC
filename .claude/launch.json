{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Streamlit Dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "access_defense/dashboard.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "Vulnerable HTTP Server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "access_defense.server", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "AI Agent Loop (Qwen 2.5)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "access_defense.agent_loop", "--model", "qwen2.5", "--interval", "3"],
      "port": 0
    },
    {
      "name": "AI Agent Loop (Llama 3.1)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "access_defense.agent_loop", "--model", "llama3.1", "--interval", "3"],
      "port": 0
    },
    {
      "name": "Defense Proxy (Juice Shop)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "access_defense.proxy", "--port", "9000", "--upstream", "http://localhost:3000", "--name", "juice-shop"],
      "port": 9000
    },
    {
      "name": "Defense Proxy (crAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "access_defense.proxy", "--port", "9001", "--upstream", "http://localhost:8888", "--name", "crapi"],
      "port": 9001
    }
  ]
}
